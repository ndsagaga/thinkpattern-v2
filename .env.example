# Local dev env — copy to `.env.local` and fill in.
# `.env.local` is gitignored. Production / preview builds source these
# from EAS build profiles in `eas.json`.

# CDN root that serves manifest.json + all per-object content (1.0 contract).
EXPO_PUBLIC_CDN_BASE_URL=https://internal.thinkpattern.ai

# Sentry: ingest-only DSN, safe to ship in client bundles.
EXPO_PUBLIC_SENTRY_DSN=

# PostHog: project API key + region host (us or eu, picked at signup).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Build environment label (development | preview | production), baked per EAS
# profile to tag Sentry events + PostHog super-properties. Leave unset locally
# — it falls back to 'local', and telemetry is disabled in __DEV__ anyway.
EXPO_PUBLIC_ENV=
